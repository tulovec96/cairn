{
  "name": "filesystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "setup": "prisma migrate deploy && prisma generate",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "test": "vitest run tests/unit",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:s3": "node scripts/run-integration.mjs --s3"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "file-type": "^22.1.1",
    "lucide-react": "^1.48.0",
    "mime-types": "^3.0.2",
    "next": "16.3.6",
    "prism-react-renderer": "^2.4.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
